# Copia este archivo con el nombre .env.local y pon los datos de TU proyecto de Supabase.
# (Supabase > botón "Connect", o Project Settings > API Keys)
# Usa la llave "publishable" (o "anon public"). NUNCA pongas aquí la llave "secret" ni "service_role".

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=pega_aqui_tu_llave_publishable
